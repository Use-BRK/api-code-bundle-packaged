# Porta em que a API vai rodar
PORT=3000

# Caminho do arquivo SQLite onde o bundle é persistido (relativo ou absoluto)
# O diretório é criado automaticamente se não existir.
BUNDLE_DB_PATH=./data/bundle.sqlite

# Chave que clientes precisam enviar no header x-api-key para chamar POST /bundle.
# GET /script.js é público (sem autenticação) — é chamado pelo loader no browser.
API_KEY=troque-esta-chave-em-producao

# Origens permitidas pelo CORS (separadas por vírgula). Use "*" para liberar geral
# (aceitável aqui porque POST /bundle já exige x-api-key). Em produção, prefira
# listar apenas os domínios do gerenciador, ex:
# CORS_ORIGINS=http://localhost:3000,https://gerenciador.exemplo.com
CORS_ORIGINS=*
